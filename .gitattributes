# 强制全仓库文本文件使用 LF（根治 macOS LF vs Windows core.autocrlf=true 导致 SHA-256 与 Git 漂移）
* text=auto eol=lf
*.md text eol=lf linguist-documentation
*.mdx text eol=lf linguist-documentation
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf

docs/** linguist-documentation
content/** linguist-documentation

# 飞书/skill 工具链，不计入产品语言条
.agents/** linguist-vendored

# 构建产物（若被跟踪）不参与统计
apps/web/src/generated/** linguist-generated
