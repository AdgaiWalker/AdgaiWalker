# —— SQLite 文件；将路径改为本机绝对路径，开发/测试/生产分别使用不同文件 ——
DATABASE_URL="file:/absolute/path/to/walker.db"
WALKER_DB_PROVIDER=sqlite

# 仅当为 true 时 Intake 等才调模型
AI_ENABLED=false

HOST=127.0.0.1
PORT=8788
NODE_ENV=development

# Exact browser-origin hosts accepted when a trusted reverse proxy changes Host; do not include a scheme.
# Production public-site writes proxied from www.iwalk.pro require this host entry.
# WALKER_PUBLIC_ORIGINS=www.iwalk.pro

# 验收用：强制存储不可写
# STORAGE_UNAVAILABLE=true

# 管理端内容目录（默认探测 monorepo content/log）
# CONTENT_LOG_DIR=/absolute/path/to/content/log

# 保存内容后是否自动 pnpm content:gen（默认开）
# CONTENT_GEN_ON_SAVE=false

# 内容发布（pnpm content:publish）
# CONTENT_PUBLISH_COMMIT=true
# CONTENT_PUBLISH_PUSH=true
# API 和手工发布脚本共用同一绝对锁路径；生产配置见部署手册。
# WALKER_CONTENT_LOCK_PATH=<absolute-private-data-path>/content-publish.lock

# AI content workstation artifacts; defaults to <repo>/var/works
# WORK_ROOT_DIR=D:/path/to/AdgaiWalker/var/works

# Maximum bytes per original file; default 104857600 (100 MiB)
# WORK_MAX_UPLOAD_BYTES=104857600

# V18/V19 deletion recovery; defaults are derived from DATABASE_URL under <Walker root>/control.
# Configure the replica only when an off-host or separately durable location is available.
# WALKER_DELETION_MANIFEST_PATH=/absolute/path/to/control/deletion-manifest.json
# WALKER_DELETION_MANIFEST_REPLICA_PATH=/absolute/path/on/another/storage/deletion-manifest.json
# WALKER_RESTORE_GATE_FILE=/absolute/path/to/control/restore.pending

# V21 private, short-lived conversation export files; defaults to <API cwd>/data/exports.
# Keep this directory outside static hosting; generated files expire after 15 minutes.
# WALKER_EXPORT_DIR=/absolute/path/to/private/exports

# V23 public-position readiness requires a real runtime-isolation probe report.
# The report must contain a verified answer, no close error, and processExited=true.
# WALKER_RUNTIME_PROBE_REPORT=/absolute/path/to/runtime-probe.json
# WALKER_MEMORY_HEADROOM_MB defaults to 512. Set to 0 only for a local demo on hosts with unreliable free-memory sampling; keep the production readiness threshold.

# Visitor assistant time budget per question, in ms (default 15000).
# When the budget runs out, the text the model already produced is delivered and flagged
# partial=true. It is not discarded in favour of the canned rule answer ("AI 未启用"),
# which is what used to happen and read to visitors as "the AI is not serving".
# WALKER_ASSISTANT_ASK_TIMEOUT_MS=15000
