// 默认：本地开发 SQLite（file: URL）
// 未来生产 PG：用 schema.postgresql.prisma + WALKER_DB_PROVIDER=postgresql
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SchemaMeta {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Clue {
  id         String   @id
  body       String
  source     String
  poolStatus String   @default("candidate")
  anonId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  seedLinks SeedClueLink[]

  @@index([poolStatus])
  @@index([createdAt])
}

model Seed {
  id            String   @id
  title         String
  severity      String?
  selfInterest  String?
  primaryClueId String?
  workflowStatus String  @default("INBOX")
  whyNow         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  links      SeedClueLink[]
  executions Execution[]
}

model SeedClueLink {
  id     String @id
  seedId String
  clueId String
  role   String

  seed Seed @relation(fields: [seedId], references: [id], onDelete: Cascade)
  clue Clue @relation(fields: [clueId], references: [id], onDelete: Cascade)

  @@unique([seedId, clueId])
  @@index([clueId])
}

model Execution {
  id            String   @id
  seedId        String
  status        String   @default("doing")
  deliveryUrl   String?
  deliveryForm  String?
  deliveryNote  String?
  outcome       String?
  evidence      String?
  contentBrief  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  seed Seed @relation(fields: [seedId], references: [id], onDelete: Cascade)
  submission Submission?

  @@index([seedId])
}

model Submission {
  id                   String   @id
  executionId          String   @unique
  idempotencyKey       String   @unique
  title                String
  status               String   @default("DRAFT_READY")
  manifestPath         String
  coreViewpoint        String
  protectedClaims      Json
  approvedArtifactHash String?
  currentStage         String?
  stageStartedAt       DateTime?
  lastOutputAt         DateTime?
  waitingReason        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  publications Publication[]

  @@index([status])
  @@index([createdAt])
}

model Action {
  id          String   @id
  title       String
  note        String?
  kind        String   @default("TASK")
  entityType  String?
  entityId    String?
  status      String   @default("OPEN")
  plannedDate String?
  completedAt DateTime?
  source      String   @default("HUMAN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([plannedDate])
  @@index([entityType, entityId])
}

model Publication {
  id            String   @id
  submissionId  String
  channel       String
  artifactHash  String
  status        String   @default("PENDING")
  url           String?
  lastError     String?
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, channel])
  @@index([status])
}

model GuestQuota {
  anonId    String   @id
  usedCount Int      @default(0)
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

model FeatureEvent {
  id         String   @id
  at         DateTime @default(now())
  featureKey String
  event      String
  actorType  String
  failCode   String?
  props      Json?
  @@index([featureKey, event])
  @@index([at])
}

model LikeCounter {
  path      String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model ContentFeedback {
  id        String   @id
  contentId String
  signal    String
  note      String?
  source    String   @default("unknown")
  convertedSeedId String?
  convertedActionId String?
  createdAt DateTime @default(now())

  @@index([contentId])
  @@index([createdAt])
}

model SearchMiss {
  id        String   @id
  query     String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AssistantSession {
  id          String   @id
  anonId      String
  sessionId   String
  runner      String   @default("harness")
  lastActiveAt DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([anonId, sessionId])
  @@index([anonId])
}

model AssistantRun {
  id         String   @id
  sessionId  String
  question   String
  answer     String
  citations  String   @default("[]")
  aiUsedFlag Boolean
  elapsedMs  Int      @default(0)
  traceId    String?
  source     String   @default("assistant-panel")
  createdAt  DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model AssistantBudget {
  date      String   @id
  requests  Int      @default(0)
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// 管理凭据库：密文存储（AES-256-GCM），明文绝不入库、绝不进 Git。
model Credential {
  id         String   @id
  name       String   @unique
  provider   String
  ciphertext String
  iv         String
  authTag    String
  last4      String
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
