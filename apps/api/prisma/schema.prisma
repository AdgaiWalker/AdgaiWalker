// 唯一现行 schema：SQLite。既有 PostgreSQL 文件仅存于 legacy-postgresql 供历史查阅。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SchemaMeta {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Clue {
  id         String   @id
  body       String
  source     String
  poolStatus String   @default("candidate")
  anonId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  seedLinks SeedClueLink[]

  @@index([poolStatus])
  @@index([createdAt])
}

model Seed {
  id            String   @id
  title         String
  severity      String?
  selfInterest  String?
  primaryClueId String?
  workflowStatus String  @default("INBOX")
  whyNow         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  links      SeedClueLink[]
  executions Execution[]
}

model SeedClueLink {
  id     String @id
  seedId String
  clueId String
  role   String

  seed Seed @relation(fields: [seedId], references: [id], onDelete: Cascade)
  clue Clue @relation(fields: [clueId], references: [id], onDelete: Cascade)

  @@unique([seedId, clueId])
  @@index([clueId])
}

model Execution {
  id            String   @id
  seedId        String
  status        String   @default("doing")
  deliveryUrl   String?
  deliveryForm  String?
  deliveryNote  String?
  outcome       String?
  evidence      String?
  contentBrief  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  seed Seed @relation(fields: [seedId], references: [id], onDelete: Cascade)
  submission Submission?

  @@index([seedId])
}

model Submission {
  id                   String   @id
  executionId          String   @unique
  idempotencyKey       String   @unique
  title                String
  status               String   @default("DRAFT_READY")
  manifestPath         String
  coreViewpoint        String
  protectedClaims      Json
  approvedArtifactHash String?
  currentStage         String?
  stageStartedAt       DateTime?
  lastOutputAt         DateTime?
  waitingReason        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  publications Publication[]

  @@index([status])
  @@index([createdAt])
}

model Action {
  id          String   @id
  title       String
  note        String?
  kind        String   @default("TASK")
  entityType  String?
  entityId    String?
  status      String   @default("OPEN")
  plannedDate String?
  /// 到期 UTC 瞬时；由 plannedDate + timezone 推导，未排期为 null（旧行不反推）
  dueAt       DateTime?
  /// 生成 dueAt 时使用的 IANA 时区，保证 "日期 → UTC → 日期" 可还原
  timezone    String?
  completedAt DateTime?
  source      String   @default("HUMAN")
  /// O05：访客问题转事项时保存的**证据软引用** { conversationId, messageIds, capturedAt }。
  /// 刻意不加外键：会话删除后事项必须保留并如实显示「证据已不可用」。
  evidenceRef Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  occurrences ReminderOccurrence[]
  reviews     ReviewEntry[]

  @@index([status])
  @@index([plannedDate])
  @@index([dueAt, status])
  @@index([entityType, entityId])
}

/// 提醒发生记录：同一事项、同一到期瞬时只允许一条（唯一键去重，重复扫描不重复产生）。
model ReminderOccurrence {
  id         String   @id
  actionId   String
  /// 去重键 = actionId@dueAt@timezone，唯一约束即幂等保证
  dedupeKey  String   @unique
  dueAt      DateTime
  timezone   String
  /// 站主如何处置这次到期：PENDING 待处理 / DONE 完成 / SNOOZED 延后 / IGNORED 忽略
  outcome    String   @default("PENDING")
  /// 忽略或延后的原因（自由文本，可空）
  reason     String?
  notifiedAt DateTime @default(now())
  resolvedAt DateTime?
  createdAt  DateTime @default(now())

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId, createdAt])
  @@index([outcome, createdAt])
}

/// 一次内容更新复盘：关联 Action 与已核验发布版本，记录行为、观察窗口与下一次尝试。
model ReviewEntry {
  id              String   @id
  /// 关联的事项；复盘必须挂在一次具体动作上
  actionId        String
  /// 关联的已核验发布版本（可空：人工编辑类复盘未必有发布）
  releaseId       String?
  /// 本次做了什么（自由文本，不强制固定方法论）
  didWhat         String
  /// 观察到的结果（自由文本，可空）
  observed        String?
  /// 观察窗口（站点本地日期，含首尾）
  windowStart     String?
  windowEnd       String?
  /// 下一次尝试（自由文本；必须显式转为 Action，不在此自动执行）
  nextAttempt     String?
  /// 证据充分度：SUFFICIENT 足够 / INSUFFICIENT 不足 / UNKNOWN 未知（样本不足时如实写未知）
  evidenceState   String   @default("UNKNOWN")
  /// 采集缺口的说明（哪个指标没有分母/覆盖不全）
  evidenceNote    String?
  /// 由谁创建：站主或明确授权的后台操作
  createdBy       String   @default("owner")
  /// 幂等键：同一次复盘重复提交返回同一记录
  requestKey      String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId, createdAt])
  @@index([createdAt])
}

model Publication {
  id            String   @id
  submissionId  String
  channel       String
  artifactHash  String
  status        String   @default("PENDING")
  url           String?
  lastError     String?
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, channel])
  @@index([status])
}

/// 新内容候选：保存审批绑定与文件版本事实，不表示网页或问答索引已发布。
model ContentChange {
  id                 String   @id
  action             String   @default("apply-candidate")
  targetSlug         String
  baseHash           String
  candidateHash      String
  candidateRef       String
  sourceRunId        String?
  state              String   @default("PROPOSED")
  applyApprovalId    String?
  applyApprovalHash  String?
  applyGrantId       String?
  applyGrantRevision Int?
  applyApprovedBy    String?
  applyApprovedAt    DateTime?
  appliedHash        String?
  requestKey         String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  releases ContentRelease[]

  @@index([targetSlug, state, createdAt])
  @@index([sourceRunId])
}

/// 网页发布事务：远端核验阶段与助手索引同步状态分别保存。
model ContentRelease {
  id                    String   @id
  changeId              String
  action                String   @default("publish-website")
  targetSlug            String
  baseHash              String
  sourceHash            String
  publishApprovalId     String
  publishApprovalHash   String
  publishGrantId        String
  publishGrantRevision  Int
  publishApprovedBy     String
  publishApprovedAt     DateTime
  stage                 String   @default("PREPARED")
  assistantIndexState   String   @default("PENDING")
  manifestHash          String?
  manifestRef           String?
  gitCommit             String?
  publishedSnapshotId   String?
  verifiedHash          String?
  verifiedAt            DateTime?
  errorCode             String?
  versionNote           String?
  requestKey            String   @unique
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  change ContentChange @relation(fields: [changeId], references: [id], onDelete: Restrict)

  @@index([changeId, createdAt])
  @@index([targetSlug, stage, createdAt])
  @@index([stage, updatedAt])
}

model GuestQuota {
  anonId    String   @id
  usedCount Int      @default(0)
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

model FeatureEvent {
  id             String   @id
  at             DateTime @default(now())
  featureKey     String
  event          String
  actorType      String
  failCode       String?
  props          Json?
  /// V07：客户端稳定事件 ID（去重键）；receivedAt 是服务端接收时间，客户端时间不充当事实
  eventId        String?  @unique
  conversationId String?
  receivedAt     DateTime @default(now())
  @@index([featureKey, event])
  @@index([at])
  @@index([conversationId])
}

/// 业务会话：访客在某位置的连续问答。SDK session 只是关联资源，不是主键。
model Conversation {
  id           String   @id
  anonId       String
  placementKey String
  scopeSlug    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  turns       ConversationTurn[]
  sdkSessions ConversationSdkSession[]

  @@index([anonId, updatedAt])
  @@index([updatedAt, id])
  @@index([placementKey, scopeSlug])
}

/// 正文、副本和文件的逻辑登记。conversationId 不设外键，以便清理 Conversation 后保留登记到删除完成。
/// resourceKey 是服务端来源 ID，不是文件路径；实际位置由 resourceType 对应的 adapter 推导。
model ConversationLogResource {
  id                String   @id @default(cuid())
  conversationId    String?
  resourceType      String
  resourceKey       String
  agentRevisionId   String?
  parentKey         String?
  resourceCreatedAt DateTime @default(now())
  registeredAt      DateTime @default(now())

  @@unique([resourceType, resourceKey])
  @@index([conversationId, resourceCreatedAt])
  @@index([resourceType, resourceCreatedAt])
  @@index([agentRevisionId])
  @@index([parentKey])
}

/// 删除状态用于跨进程恢复；不保存正文，且不依赖 Conversation 外键级联。
model DeletionTombstone {
  id             String    @id @default(cuid())
  conversationId String    @unique
  state          String    @default("pending")
  attempts       Int       @default(0)
  lastErrorCode  String?
  requestedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  @@index([state, requestedAt])
}

/// 站点唯一日志保留设置；明细与不可回连聚合单独控制，接口只能缩短默认期限。
model LogRetentionPolicy {
  id                    String   @id @default("site")
  detailRetentionDays   Int      @default(90)
  aggregateRetentionDays Int     @default(365)
  updatedAt             DateTime @updatedAt
}

/// 访客对话导出任务。筛选与截止时间在创建时冻结；实际文件由本机受控目录存放。
model ConversationExportJob {
  id              String   @id
  format          String
  status          String   @default("QUEUED")
  filters         Json
  snapshotAt      DateTime
  retentionCutoff DateTime
  rowCount        Int      @default(0)
  errorCode       String?

  @@index([status, snapshotAt])
}

/// 业务会话 ↔ 模型 session 关联：切换 Agent 成员时同一会话建另一行，模型上下文独立。
model ConversationSdkSession {
  id              String   @id
  conversationId  String
  agentRevisionId String
  sdkSessionId    String
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, agentRevisionId])
}

/// 一轮问答 = 一条访客消息。requestKey 是访客消息幂等键。
model ConversationTurn {
  id             String   @id
  conversationId String
  seq            Int
  requestKey     String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages     ConversationMessage[]
  attempts     ConversationAttempt[]

  @@unique([conversationId, requestKey])
  @@unique([conversationId, seq])
}

/// 一次生成尝试。重新生成单列一行，互不覆盖；runId 关联统一执行（可空：规则降级没有运行）。
model ConversationAttempt {
  id              String   @id
  turnId          String
  agentRevisionId String
  runId           String?
  state           String   @default("pending")
  createdAt       DateTime @default(now())

  turn     ConversationTurn      @relation(fields: [turnId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@index([turnId])
  @@index([runId])
}

/// 会话消息。delivery：pending/sent/ack/unknown，生成成功不等于交付成功。
model ConversationMessage {
  id         String   @id
  turnId     String
  attemptId  String?
  role       String
  body       String
  delivery   String   @default("pending")
  createdAt  DateTime @default(now())

  turn    ConversationTurn     @relation(fields: [turnId], references: [id], onDelete: Cascade)
  attempt ConversationAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@index([turnId, createdAt])
  @@index([attemptId])
}

model LikeCounter {
  path      String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model ContentFeedback {
  id        String   @id
  contentId String
  signal    String
  note      String?
  source    String   @default("unknown")
  convertedSeedId String?
  convertedActionId String?
  createdAt DateTime @default(now())

  @@index([contentId])
  @@index([createdAt])
}

model SearchMiss {
  id        String   @id
  query     String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AssistantSession {
  id          String   @id
  anonId      String
  sessionId   String
  runner      String   @default("harness")
  agentRevisionId String?
  lastActiveAt DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([anonId, sessionId])
  @@index([anonId])
}

model AssistantRun {
  id         String   @id
  sessionId  String
  question   String
  answer     String
  citations  String   @default("[]")
  aiUsedFlag Boolean
  elapsedMs  Int      @default(0)
  traceId    String?
  source     String   @default("assistant-panel")
  /// 观测 P1：token 用量（多 step 求和；缺失记 0）
  tokensIn        Int     @default(0)
  tokensOut       Int     @default(0)
  cacheReadTokens Int     @default(0)
  /// 观测 P1：拿锁 → 首字、排队等待
  firstChunkMs Int?
  queueWaitMs  Int?
  /// 观测 P1：降级原因（kebab 词表；正常 AI 回答为 null）
  degradeReason String?
  /// V08：匿名身份的服务端 hash 与持久 requestKey（重复发送返回原 run）
  anonIdHash  String?
  requestKey  String?
  createdAt  DateTime @default(now())

  @@unique([anonIdHash, requestKey])
  @@index([sessionId])
  @@index([createdAt])
}

model AssistantBudget {
  date      String   @id
  requests  Int      @default(0)
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  updatedAt DateTime @updatedAt
}

model InsightReport {
  id            String   @id
  weekOf        String
  inputSnapshot String
  report        String
  createdAt     DateTime @default(now())

  @@index([weekOf])
  @@index([createdAt])
}

/// 提供方与凭据以 dsh 原生管理为唯一真相源（R25c，2026-09-23）：
/// 旧的 ModelProvider / Credential 表已删除，不再有本地提供方注册表。

/// 智能体单位 (以 Agent 为核心的人设与模型挂载)
model AgentUnit {
  id          String         @id // 'xiaoying' 或 c_xxxx (自定义)
  name        String         // 智能体名称
  icon        String         @default("bot") // 'bot' | 'pen-tool' | 'sparkles'
  isSystem    Boolean        @default(false) // 小影为 true，后端 403 绝不可删
  /// 提供方接口 id（dsh 原生目录里的路由名，如 deepseek-official）。
  /// 2026-09-23 起不再有本地外键：提供方以 dsh 设置为唯一真相源（R25）。
  providerId  String?
  modelId     String         @default("deepseek-chat") // 挂载的具体模型标识
  prompt      String         // 系统提示词定义 (System Prompt)
  archivedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  runs        AgentRun[]
  revisions   AgentRevision[]
}

/// 配置快照不可变；具体修订行为由 R06 接入。
model AgentRevision {
  id            String   @id
  agentId       String
  version       Int
  prompt        String
  providerId    String?
  modelId       String
  toolProfile   Json
  schemaVersion Int
  configHash    String
  createdAt     DateTime @default(now())

  agent AgentUnit @relation(fields: [agentId], references: [id], onDelete: Restrict)
  runs  ExecutionRun[]
  deploymentMembers DeploymentMember[]

  @@unique([agentId, version])
  @@index([createdAt])
}

/// 位置绑定：公开位置的 Agent 部署。成员钉住不可变修订，草稿变化不覆盖已部署版本。
model AgentDeployment {
  id           String   @id
  placementKey String
  scopeKind    String
  scopeSlug    String
  generation   Int      @default(1)
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members DeploymentMember[]

  @@unique([placementKey, scopeKind, scopeSlug])
  @@index([enabled])
}

/// 部署成员：引用不可变 AgentRevision；每个部署恰有一个默认成员（应用层事务保证）。
model DeploymentMember {
  id              String   @id
  deploymentId    String
  agentRevisionId String
  isDefault       Boolean  @default(false)
  generation      Int
  createdAt       DateTime @default(now())

  deployment    AgentDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  agentRevision AgentRevision   @relation(fields: [agentRevisionId], references: [id], onDelete: Restrict)

  @@unique([deploymentId, agentRevisionId])
  @@index([agentRevisionId])
}

/// 新执行生命周期权威；历史 AgentRun/SkillRun 仍单独保留。
model ExecutionRun {
  id                   String    @id
  kind                 String
  origin               String
  actor                String
  actorScope           String
  agentRevisionId      String?
  deploymentId         String?
  placementKey          String?
  deploymentGeneration Int?
  contentSnapshotId    String?
  grantId              String?
  requestKey           String
  inputHash            String
  input                String?
  resourceScope        Json?
  parentRunId          String?
  state                String    @default("QUEUED")
  attempt              Int       @default(0)
  leaseOwner           String?
  leaseEpoch           Int       @default(0)
  leaseUntil           DateTime?
  deadline             DateTime?
  stopReason           String?
  tokensIn             Int?
  tokensOut            Int?
  elapsedMs            Int?
  testCaseId           String?
  suiteVersion         Int?
  configHash           String?
  assertion            Json?
  retainUntil          DateTime?
  diagnosticName       String?
  /// G01：旧数据导入溯源与幂等去重；无法恢复的修订/用量保持未知
  legacySource         String?
  legacyId             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  process ProcessRecord?
  events  ExecutionEvent[]

  agentRevision AgentRevision? @relation(fields: [agentRevisionId], references: [id], onDelete: Restrict)
  parent        ExecutionRun?  @relation("RunChildren", fields: [parentRunId], references: [id], onDelete: Restrict)
  children      ExecutionRun[] @relation("RunChildren")

  @@unique([actorScope, requestKey])
  @@unique([legacySource, legacyId])
  @@index([state, createdAt])
  @@index([agentRevisionId])
  @@index([parentRunId])
}

/// runner 私有进程记录。PID 可被系统复用，必须连同启动时间核对。
model ProcessRecord {
  runId     String   @id
  bootId    String
  pid       Int?
  startedAt String?
  createdAt DateTime @default(now())

  run ExecutionRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([bootId])
}

/// 一次运行的实际观察。只记录 runtime 发出的文本和用量。
model ExecutionEvent {
  id        String   @id
  runId     String
  seq       Int
  kind      String
  text      String?
  tokensIn  Int?
  tokensOut Int?
  createdAt DateTime @default(now())

  run ExecutionRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, seq])
  @@index([runId, seq])
}

/// 事项授权按动作、对象和期限收窄；R08 再开放创建/撤销入口。
model AuthorizationGrant {
  id            String    @id
  principalType String
  principalId   String
  agentId       String?
  origin        String
  actions       Json
  resourceScope Json
  expiresAt     DateTime?
  runLimit      Int?
  usageLimit    Int?
  runsReserved  Int       @default(0)
  runsCharged   Int       @default(0)
  usageReserved Int       @default(0)
  usageCharged  Int       @default(0)
  revision      Int       @default(1)
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([principalType, principalId])
  @@index([agentId])
  @@index([expiresAt])
}

/// 一次运行最多一条额度占用。reserved 还没扣费，charged 才是已结算。
model ExecutionQuotaHold {
  runId     String   @id
  grantId   String
  state     String
  usage     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([grantId])
}

/// 全局单槽的公平计数。只有这一行。
model ExecutionSchedule {
  id                      String @id
  consecutivePublicClaims Int    @default(0)
}

model AuditRecord {
  id         String   @id
  actor      String
  action     String
  targetType String
  targetId   String
  beforeHash String?
  afterHash  String?
  outcome    String
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
  @@unique([action, targetType, requestId])
}

/// 管理 HTTP 请求时间线。只记录路由元数据；业务事实继续由 AuditRecord 持有。
model AdminRequestLog {
  id         String    @id
  actor      String
  method     String
  path       String
  statusCode Int?
  durationMs Int?
  createdAt  DateTime  @default(now())

  @@index([createdAt, id])
  @@index([method, createdAt])
}

model Outbox {
  id            String    @id
  eventKey      String    @unique
  topic         String
  aggregateId   String
  payloadRef    String?
  attempt       Int       @default(0)
  nextAt        DateTime  @default(now())
  deliveredAt   DateTime?
  deadAt        DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([deliveredAt, deadAt, nextAt])
  @@index([aggregateId])
}

/// 智能体运行履历索引 (B-trace 轨迹轻量索引)
/// 技能运行记录 —— 「堆起来的数据」。
/// skillId 不设外键：技能真身在 `skills/<id>/`（文件），删了文件历史数据仍应保留。
model SkillRun {
  id               String   @id @default(cuid())
  skillId          String
  skillVersion     String   @default("")
  providerId       String?  // 归因：本次实际使用的供应商
  temperature      Float?
  input            String   @default("") // 输入（过长时截断，避免把整篇文件塞进库）
  output           String   @default("") // 成功即输出；失败为错误信息
  model            String   @default("")
  status           String   @default("SUCCESS") // SUCCESS | FAILED
  errorCode        String? // 失败分类码（model-credential-missing 等），便于按原因统计
  tokensPrompt     Int      @default(0)
  tokensCompletion Int      @default(0)
  elapsedMs        Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([skillId])
  @@index([createdAt])
}

model AgentRun {
  id               String      @id @default(cuid())
  agentId          String
  targetFile       String?     // 调用的文件相对路径 (如 content/log/xxx.md)
  instruction      String      // 站主指令
  output           String      // 最终产物文本
  model            String      // 调用时的模型标识
  providerId       String?     // 归因：本次实际使用的供应商（解析后的）
  promptSnapshot   String?     // 归因：当次系统提示词全文（调试的锚点）
  temperature      Float?      // 归因：当次采样参数
  tokensPrompt     Int         @default(0)
  tokensCompletion Int         @default(0)
  tokensCacheHit   Int         @default(0) // 缓存命中 tokens
  cacheHitPercent  Float       @default(0.0) // 缓存命中百分比 (如 72.5)
  elapsedMs        Int         @default(0)
  traceLogPath     String?     // 对应的独立 trace.jsonl 物理路径
  status           String      @default("SUCCESS") // 'SUCCESS' | 'FAILED'
  createdAt        DateTime    @default(now())

  agent            AgentUnit   @relation(fields: [agentId], references: [id], onDelete: Restrict)
  @@index([agentId])
  @@index([createdAt])
}
