    "@deepseek-ai/dsh-workflow": "0.1.5-rc.3",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@prisma/client": "^6.10.1",
    "@walker/shared": "workspace:*",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
