{
  "name": "@walker/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/main.ts",
    "start": "tsx --tsconfig tsconfig.json src/main.ts",
    "start:prod": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "tsx ../../scripts/prisma-env.ts generate",
    "prisma:migrate": "tsx ../../scripts/prisma-env.ts migrate",
    "prisma:baseline": "tsx ../../scripts/prisma-env.ts baseline",
    "prisma:deploy": "tsx ../../scripts/prisma-env.ts migrate",
    "log:maintenance": "tsx src/log-resources/log-maintenance.cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
