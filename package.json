{
  "name": "adgai-walker",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "content:gen": "tsx scripts/generate-content.ts",
    "code:gen": "tsx scripts/generate-code-graph.ts",
    "content:publish": "tsx scripts/content-publish.ts",
    "dev:web": "pnpm content:gen && pnpm --filter @walker/web dev",
    "dev:admin": "pnpm --filter @walker/admin dev",
    "start:api:prod": "pnpm --filter @walker/api start:prod",
    "dev:api": "pnpm --filter @walker/api dev",
    "build:web": "tsx scripts/build-web.ts",
    "build:admin": "pnpm --filter @walker/admin build",
    "build:api": "pnpm --filter @walker/api build",
    "build:shared": "pnpm --filter @walker/shared build",
    "test:shared": "pnpm --filter @walker/shared test",
    "test:api": "pnpm build:shared && pnpm --filter @walker/api test",
    "test:web": "pnpm --filter @walker/web test",
    "test:agent": "pnpm build:shared && pnpm --filter @walker/agent test",
    "typecheck": "pnpm build:shared && pnpm -r run typecheck && tsc -p scripts/tsconfig.json",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "db:generate": "tsx scripts/prisma-env.ts generate",
    "db:baseline": "tsx scripts/prisma-env.ts baseline",
    "db:migrate": "tsx scripts/prisma-env.ts migrate",
    "check:content-fields": "tsx scripts/check-content-fields.ts",
    "check:content-dirty": "tsx scripts/check-uncommitted-content.ts",
    "verify:geo": "tsx scripts/verify-geo.ts",
    "verify:architecture": "tsx scripts/verify-architecture.ts",
    "harness:update": "tsx scripts/update-harness.ts",
    "harness:check": "tsx scripts/update-harness.ts --dry-run",
    "verify:stage1": "tsx scripts/verify-stage1.ts",
    "accept:ai-workstation:mvp": "tsx scripts/mvp-acceptance.ts",
    "accept:dual-entry": "tsx scripts/accept-dual-entry.ts",
    "accept:deep": "tsx scripts/accept-deep.ts",
    "accept": "tsx scripts/accept-dual-entry.ts && tsx scripts/accept-deep.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "@walker/shared": "workspace:*",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
