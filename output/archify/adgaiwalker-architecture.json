  "cards": [
    {
      "dot": "cyan",
      "title": "三面与唯一运行时",
      "items": [
        "访客面：静态站 + 预渲染文章，运行时只读 content.json",
        "站主面：apps/admin 经 SSH 隧道与双防线，AI 只起草不主选",
        "AI 面：dsh 是唯一运行时，助手 / 卡口 / 配方共用一个引擎"
      ]
    },
    {
      "dot": "amber",
      "title": "边界与红线",
      "items": [
        "公网白名单双侧同步：Nest exclude 表 + Caddyfile，漏一侧即 401/404",
        "变更方法统一校验 Origin/Referer；凭据只存服务器 data 目录",
        "访客输入永不进命令行，只走 JSON-RPC stdin 数据通道"
      ]
    },
    {
      "dot": "emerald",
      "title": "真相源与实施状态",
      "items": [
        "内容正本只有 content/log；content.json 与图谱都是可重算投影",
        "盒子坚持单 Nest + SQLite，26 条迁移；不引入 Docker / Redis / PostgreSQL / 外部监控栈",
        "C01–C24 与 O01–O10 已验收，G01–G06 完成、下一项 G07；2026-10-12 的监控台与 Agent 直调修复仍是本地未提交，生产未部署，readiness 仍阻断公共位置启用"
      ]
    },
    {
      "dot": "cyan",
      "title": "Token 面（85b597b）",
      "items": [
        "token.iwalk.pro 公网只放 /v1/*（Bearer）与 /connect* 自助页，面板与 healthz 永不出口",
        "上游是笔记本经 Tailscale serve，透传 upstream Host，不参与 Nest 公网路由对等契约",
        "盒子只反代两条前缀，凭据与面板留在回环"
      ]
    },
    {
      "dot": "emerald",
      "title": "运行监控（2026-10-12 本地）",
      "items": [
        "fail 语义相反且刻意如此：监控采集 fail-open（坏了业务照跑），后台日志 fail-closed（写不进去 503 拒绝执行）",
        "频道与报错判定、比率显示只有一份 shared 实现；筛选一律在服务端，分母为 0 显示「—」",
        "只读、进程内、不落库、不新增主工作面；后台「运行监控」tab 经管理鉴权读 /ops/runtime/*，不进公网白名单",
        "所以图上属于 Nest 进程内部（端口→适配器在 kernel 接线），不是独立组件，也不单列节点；已知盲区是 API 崩溃时缓冲同归于尽，终端仍是唯一现场",
        "能力自身的文件（采集接线 / 端口 / 控制器与 shared 契约）尚未提交，图面证据钉在它依赖的既有采集面与接线处"
      ]
    }
