# Public surface: only the visitor-facing API contract is reachable from the Internet.
# WALKER_PUBLIC_API_HOST example: api.example.com
{$WALKER_PUBLIC_API_HOST} {
  encode zstd gzip

  route {
    @health {
      method GET
      path /health
    }
    handle @health {
      reverse_proxy 127.0.0.1:8788
    }

    @intake {
      method POST
      path /intake
    }
    handle @intake {
      reverse_proxy 127.0.0.1:8788
    }

    @assistantPlacement {
      method GET
      path /assistant/placements/*/*
    }
    handle @assistantPlacement {
      reverse_proxy 127.0.0.1:8788
    }

    @assistantHistory {
      method GET
      path /assistant/conversations/*/*
    }
    handle @assistantHistory {
      reverse_proxy 127.0.0.1:8788
    }

    @assistantStop {
      method POST
      path /assistant/conversations/*/*/stop
    }
    handle @assistantStop {
      reverse_proxy 127.0.0.1:8788
    }

    @assistant {
      method POST
      path /assistant /assistant/stream /assistant/events /assistant/messages/*/ack
    }
    handle @assistant {
      reverse_proxy 127.0.0.1:8788
    }

    @likes {
      method GET POST
      path /likes
    }
    handle @likes {
      reverse_proxy 127.0.0.1:8788
    }

    @content_feedback {
      method POST
      path /content-feedback
    }
    handle @content_feedback {
      reverse_proxy 127.0.0.1:8788
    }

    @search_events {
      method POST
      path /search-events
    }
    handle @search_events {
      reverse_proxy 127.0.0.1:8788
    }

    respond "Not Found" 404
  }
}


# Token surface: the wb2api gateway that mints/uses the tokens this site calls.
# Two prefixes leave the box, nothing else:
#   /v1/*     OpenAI-compatible API (Bearer api_key)
#   /connect* the self-service page that hands a token to an invited user
# The panel, /status and /healthz stay 404 here — they must never reach the
# Internet, and the laptop keeps listening on loopback only.
#
# Upstream is the laptop over Tailscale (it runs `tailscale serve`), so the
# gateway keeps working while the laptop moves between networks, and the box
# never needs the laptop's LAN address.
#
# NOTE: this host is intentionally OUTSIDE the Nest public-route parity contract
# (compareCaddyPublicRoutes — its upstream is not Nest), which is why it uses
# inline matchers instead of @named blocks. Keep it that way, or extend the
# contract before adding named matchers.
{$WALKER_TOKEN_HOST} {
  # 保留 encode：实测对 SSE 首字节没有可测影响（各 5 次取样，中位无差异），
  # 而盒子那台的带宽是稀缺资源（腾讯云轻量常见 1-6 Mbps），省流量更值。
  encode zstd gzip

  route {
    handle /v1/* {
      reverse_proxy {$WALKER_TOKEN_UPSTREAM} {
        # tailscale serve matches on Host: rewrite it to the upstream's own name,
        # otherwise serve answers 404 (it only knows its own ts.net hostname).
        header_up Host {upstream_hostport}
      }
    }

    handle /connect* {
      reverse_proxy {$WALKER_TOKEN_UPSTREAM} {
        header_up Host {upstream_hostport}
      }
    }

    respond "Not Found" 404
  }
}
# Private owner surface: reachable only through an SSH tunnel.
# Second defense layer: basic auth. WALKER_ADMIN_USER / WALKER_ADMIN_HASH (bcrypt)
# are derived from C:\Walker\data\admin-basic-auth.txt by run-caddy.ps1.
# Example: ssh -N -L 5174:127.0.0.1:8790 walker-tencent
http://127.0.0.1:8790 {
  bind 127.0.0.1

  basic_auth {
    {$WALKER_ADMIN_USER} {$WALKER_ADMIN_HASH}
  }

  route {
    handle_path /api/* {
      reverse_proxy 127.0.0.1:8788
    }

    root * {$WALKER_ADMIN_DIST}
    try_files {path} /index.html
    file_server
  }
}

# Owner surface over HTTPS (admin.iwalk.pro): static Admin SPA + /api/* reverse proxy.
# Protected by Nest AdminTokenMiddleware (SessionGate login: x-admin-username + x-admin-token).
{$WALKER_ADMIN_HOST} {
  encode zstd gzip

  route {
    handle_path /api/* {
      reverse_proxy 127.0.0.1:8788
    }

    root * {$WALKER_ADMIN_DIST}
    try_files {path} /index.html
    file_server
  }
}
